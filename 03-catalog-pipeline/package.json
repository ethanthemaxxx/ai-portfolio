{
  "name": "cerro-alto-catalog-pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Catalog enrichment pipeline for Cerro Alto Coffee: fact-grounded product copy with hard rule gates.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
