# Dependencies and build output
node_modules/
.next/
out/
dist/
.vercel/
*.tsbuildinfo

# Secrets. Nothing that authenticates anything belongs in this repo — the demo
# runs without keys on purpose.
.env
.env.*
!.env.example

# macOS resource forks. This repo lives on an exFAT volume, which has no native
# support for extended attributes, so Finder writes them as sidecar files. They
# are noise, and a client cloning the repo should never see them.
._*
.DS_Store

# Editor
.idea/
*.swp
